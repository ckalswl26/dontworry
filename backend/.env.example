# 금융감독원 FINE Open API 인증키
FSS_API_KEY=

# Anthropic API 키 (F1 자연어 이해, F10 액션 랭킹/브리핑 생성용)
ANTHROPIC_API_KEY=

# 한국은행 ECOS Open API 인증키
ECOS_API_KEY=

# 카카오 로컬 API REST 키 (은행 지점 검색/GPS 근처 검색용) - Kakao Developers에서 앱 등록 후 즉시 발급
KAKAO_REST_API_KEY=

# 법무부 체류외국인 통계 공공데이터포털 인증키
JUSTICE_STATS_API_KEY=

# 푸시 알림 구독 저장용 Postgres 연결 문자열 (Neon/Supabase 등 무료 티어)
# 예: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# 웹 푸시 VAPID 키 쌍 (프로젝트에서 직접 생성 - 발급 계정 불필요)
VAPID_PRIVATE_KEY_B64=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# GitHub Actions 크론이 /api/push/check를 호출할 때 쓰는 공유 비밀값 (직접 생성)
PUSH_CRON_SECRET=

# CORS 허용 오리진 (콤마 구분)
CORS_ALLOW_ORIGINS=http://localhost:3000

# 환경 (development|production)
APP_ENV=development
