# 금융감독원 FINE Open API 인증키
FSS_API_KEY=

# Anthropic API 키 (F1 자연어 이해, F10 액션 랭킹/브리핑 생성용)
ANTHROPIC_API_KEY=

# 한국은행 ECOS Open API 인증키
ECOS_API_KEY=

# 법무부 체류외국인 통계 공공데이터포털 인증키
JUSTICE_STATS_API_KEY=

# CORS 허용 오리진 (콤마 구분)
CORS_ALLOW_ORIGINS=http://localhost:3000

# 환경 (development|production)
APP_ENV=development
